{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [{
    "tool": {"driver": {"name": "Semgrep", "rules": [{
      "id": "python.lang.security.sqli.string-concat",
      "shortDescription": {"text": "SQL injection via string concatenation"},
      "defaultConfiguration": {"level": "warning"},
      "properties": {"tags": ["CWE-89: Improper Neutralization of Special Elements used in an SQL Command"]}
    }]}},
    "results": [{
      "ruleId": "python.lang.security.sqli.string-concat",
      "level": "warning",
      "message": {"text": "User input concatenated into SQL query."},
      "locations": [{"physicalLocation": {"artifactLocation": {"uri": "app/db.py"}, "region": {"startLine": 6}}}]
    }]
  }]
}
